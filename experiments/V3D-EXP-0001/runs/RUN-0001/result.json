        "synthetic directed AR(1) pairs (positive control)",
        "independent AR(1) pairs (negative control)",
        "mismatched-subject pairs (real-data negative control)",
        "identical preprocessing, lag window, surrogates and correction for every pair"
      ],
      "dependent": [
        "max-statistic adjusted p-value, respiration -> heart rate",
        "lag of the strongest lagged correlation"
      ],
      "independent": [
        "pairing: same subject vs mismatched subject"
      ]
    }
